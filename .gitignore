# ==============================================================================
# INTAN (Inovasi Termal Adaptif Nusantara) - Git Ignore Configuration
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js Build Outputs ---
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# --- Environment & Secret Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local

# --- Vercel Deployment ---
.vercel/
**/.vercel/

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
**/coverage/
*.lcov
.nyc_output

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- OS-specific Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- SSL & Credentials ---
*.pem
*.key
*.cert
*.crt
